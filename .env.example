# Copy this file to .env and fill in real values.
# The project loads .env automatically on Windows and macOS; no shell export is needed.

# Tsinghua unified authentication credentials used by info (教务) and myhome (家园网) crawlers.
# WANYOU_USERNAME="your-tsinghua-id"
# WANYOU_PASSWORD="your-password"

# DeepSeek API key used by all LLM steps.
# DEEPSEEK_API_KEY="your-deepseek-api-key"

# Public-account article API key from down.mptext.top.
# WECHAT_PUBLIC_API_KEY="your-public-api-key"

# OCR.Space API key used by myhome image notices and WeChat article images.
# OCR_SPACE_API_KEY="your-ocr-api-key"

# OCR endpoints. Use /parse/image for local downloaded images and /parse/imageurl for public image URLs.
# MYHOME_IMAGE_OCR_SPACE_URL="https://api.ocr.space/parse/image"
# WECHAT_OCR_SPACE_URL="https://api.ocr.space/parse/imageurl"

# Optional: official WeChat account AppID for the reserved direct draft API.
# WECHAT_MP_APPID=""

# Optional: official WeChat account AppSecret for the reserved direct draft API.
# WECHAT_MP_APPSECRET=""

# Selenium browser: chrome, edge, or safari.
# WANYOU_SELENIUM_BROWSER="chrome"

# Keep and download images during full raw/ranked-raw collection.
# RAW_COLLECTION_KEEP_IMAGES="1"

# For myhome image notices, keep original images when OCR text is appended.
# MYHOME_IMAGE_OCR_KEEP_IMAGE="1"

# Optional: multimodal/vision LLM for image classification or future image understanding.
# IMAGE_LLM_PROVIDER="openai"
# IMAGE_LLM_BASE_URL="https://api.openai.com/v1"
# IMAGE_LLM_MODEL="gpt-4o-mini"
# IMAGE_LLM_API_KEY_ENV="OPENAI_API_KEY"
# OPENAI_API_KEY="your-vision-model-api-key"
# WECHAT_IMAGE_LLM_ENABLED="1"

# Optional: use a vision LLM as OCR fallback/preferred/only engine.
# OCR_VISION_LLM_ENABLED="1"
# OCR_VISION_LLM_MODE="fallback"
# OCR_VISION_LLM_PROVIDER="zhipuai"
# OCR_VISION_LLM_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# OCR_VISION_LLM_MODEL="glm-4v-flash"
# OCR_VISION_LLM_API_KEY_ENV="ZHIPUAI_API_KEY"
# ZHIPUAI_API_KEY="your-glm-api-key"

# Xiumi image handling: upload uses "My gallery / Upload image" and avoids base64.
# XIUMI_HOME_URL="https://xiumi.us/studio/v5?lang=zh_CN#/"
# XIUMI_IMAGE_MODE="upload"
# XIUMI_MAX_INLINE_IMAGE_HTML_CHARS="900000"
# XIUMI_IMAGE_UPLOAD_MAX_FAILURES="3"
# XIUMI_IMAGE_UPLOAD_RETRIES="1"
# XIUMI_IMAGE_UPLOAD_BATCH_SIZE="20"
# XIUMI_IMAGE_UPLOAD_STALL_SECONDS="180"

# Optional: compatible LLM endpoint and model overrides.
# LLM_PROVIDER="deepseek"
# LLM_MODEL="deepseek-v4-flash"
# LLM_BASE_URL=""
# LLM_API_KEY_ENV=""

# Optional: set to 0 if real OS environment variables should override .env values.
# WANYOU_DOTENV_OVERRIDE="1"
